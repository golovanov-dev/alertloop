# AlertLoop Monit integration - configuration.
#
# Installed to /etc/alertloop/monit.env, owned by root, mode 0600. It holds an
# API key, so nothing here belongs in version control.
#
#   sudo install -m 0600 -o root -g root alertloop.env.example /etc/alertloop/monit.env
#   sudo nano /etc/alertloop/monit.env
#
# The adapter parses this file; it does not source it. Only the keys below are
# read, and a line that is not KEY=value is ignored. Shell expansion does not
# happen: write the value literally, without $() or backticks.

# Where AlertLoop listens.
#
# Same host: use the loopback address. AlertLoop should not publish its port
# beyond 127.0.0.1, and Monit does not need it to.
#   ALERTLOOP_URL=http://127.0.0.1:8080
#
# Another host: HTTPS is required, and the adapter refuses plain HTTP to
# anything that is not localhost. The API key travels in a header on every
# request. There is no option to skip certificate verification.
#   ALERTLOOP_URL=https://alerts.example.com
ALERTLOOP_URL=http://127.0.0.1:8080

# An AlertLoop API key with the `ingest` scope, created for THIS server:
#
#   api_keys:
#     - key: "..."          # openssl rand -hex 32
#       scope: ingest       # may only create events; cannot read or resolve
#
# One key per server (or per group) so a compromised host can be cut off on its
# own. `ingest` is deliberately the whole scope: Monit needs to report events
# and nothing else.
ALERTLOOP_API_KEY=replace-me

# The host label on events you send with alertloop-send yourself, when you do
# not pass --host. Empty means hostname -s. It is not part of any dedupe_key:
# events from the Monit rules take the host Monit reports (MONIT_HOST).
ALERTLOOP_HOST=

# What appears as the event's `source` in AlertLoop. Routing rules can match on
# it, so change it only if you want the Monit events from this host routed
# separately.
ALERTLOOP_SOURCE=monit

# Timeouts, in seconds. These bound how long a Monit check can block: Monit runs
# the adapter synchronously, so an AlertLoop that hangs must not hang Monit.
ALERTLOOP_CONNECT_TIMEOUT_SECONDS=2
ALERTLOOP_TIMEOUT_SECONDS=5

# Retries. Only network errors, HTTP 429, and HTTP 5xx are retried; a 4xx is
# this host's mistake and retrying it just multiplies the noise.
#
# Keep the total small. Two retries a second apart adds at most ~2s to a check
# whose whole point is to be quick. There is no local queue: if AlertLoop is
# still unreachable after these, the event is lost and the adapter says so in
# the log. See "Limitations" in README.md.
ALERTLOOP_RETRY_COUNT=2
ALERTLOOP_RETRY_DELAY_SECONDS=1

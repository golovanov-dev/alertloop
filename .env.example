# Secrets for Docker Compose. Copy to .env next to docker-compose.yml and fill in.
# Everything else is configured in alertloop.yaml, not here.
#
# Compose does not run commands in this file: run `openssl rand -hex 32` in your
# shell and paste the output. Single-quote a value containing "$" or "#".

# Which deployment runs: demo (one container, SQLite) or postgres (production;
# needs alertloop.yaml). Edit this line to switch; do not pass --profile.
COMPOSE_PROFILES=demo

# Host port, published on 127.0.0.1 only; 8080 when unset.
# ALERTLOOP_PORT=8080

# Image to run: the release you checked out (tag without the "v"). Change it
# only as an upgrade step (OPERATIONS.md, "Upgrades and downgrades").
ALERTLOOP_IMAGE=ghcr.io/golovanov-dev/alertloop:0.6.1

# Signs in to /admin and grants full API access. Required by the postgres
# profile; the demo falls back to change-me-admin. Paste openssl output here.
ALERTLOOP_ADMIN_TOKEN=

# PostgreSQL password (postgres profile). No spaces or backslashes, no leading
# single quote; read only when the database is first created.
POSTGRES_PASSWORD=

# Optional log files of the postgres profile, in addition to stdout. First run:
#   mkdir -p logs && sudo chown 10001:10001 logs
# ALERTLOOP_LOG_FILE_API=/var/log/alertloop/api.log
# ALERTLOOP_LOG_FILE_WORKER=/var/log/alertloop/worker.log

# Example environment configuration for AlertLoop (Docker Compose / systemd).
# Copy to .env and adjust. Do not commit real secrets (.env is gitignored).
#
# Generate strong values — do not ship the placeholders below:
#   ALERTLOOP_ADMIN_TOKEN:  openssl rand -hex 32
#   POSTGRES_PASSWORD:      openssl rand -base64 32
#
# Where Compose reads .env from: the directory you run `docker compose` in (the
# project directory), NOT the directory of the compose file. The SQLite demo
# (docker-compose.yml at the repo root) reads .env from the repo root. For the
# Postgres profile run from the repo root, pass it explicitly:
#   docker compose -f deploy/docker/docker-compose.postgres.yml --env-file .env up -d

# --- Core ---
ALERTLOOP_ADDR=:8080
# Full API access + admin-console login. Sent on every request, so keep it off
# plaintext HTTP — only reach the service through the HTTPS reverse proxy.
ALERTLOOP_ADMIN_TOKEN=change-me-admin-token
ALERTLOOP_RETENTION_DAYS=30
# API keys are scoped (ingest/read/full) and are configured in the YAML file
# only (see alertloop.example.yaml). There is no ALERTLOOP_API_KEYS env var; the
# admin token above already grants full API access.

# --- Logging ---
ALERTLOOP_LOG_LEVEL=info
ALERTLOOP_LOG_FORMAT=text
# Empty = stdout. Set a path to also write logs to a file for external readers.
# ALERTLOOP_LOG_FILE=/var/log/alertloop/alertloop.log

# --- Database ---
# SQLite (demo/local): a file path.
ALERTLOOP_DB_DRIVER=sqlite
ALERTLOOP_DB_DSN=/data/alertloop.db
# PostgreSQL (production):
# ALERTLOOP_DB_DRIVER=postgres
# ALERTLOOP_DB_DSN=postgres://alertloop:alertloop@postgres:5432/alertloop?sslmode=disable

# Used by the PostgreSQL Compose profile.
POSTGRES_PASSWORD=alertloop

# --- Delivery channels ---
# Channels (email/telegram/webhook) are configured ONLY in the YAML config file
# (a single, list-based source of truth that supports multiple channels of each
# type). See alertloop.example.yaml. There are no ALERTLOOP_*_ENABLED env vars.
